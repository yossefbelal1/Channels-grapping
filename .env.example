# Telegram API Configuration
# Get these from https://my.telegram.org
API_ID=123456
API_HASH=your_api_hash_here
SESSION_SCAVENGER=scavenger_session
SESSION_RADAR=radar_session
SESSION_VALIDATOR=validator_session
SESSION_GRAPH_EXPANDER=graph_expander_session

# Redis Database Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=leadhunter_db
DB_USER=postgres
DB_PASSWORD=your_db_password_here

# Worker Behavior Configuration
# Scavenger: Time to sleep between full search cycles (default: 86400 seconds = 24 hours)
SCAVENGER_INTERVAL_SECONDS=86400
# Radar: Delay between group joins (default: 1800 seconds = 30 minutes)
JOIN_INTERVAL_SECONDS=1800

# Web Scraper: Delay between search cycles (default: 21600 seconds = 6 hours)
WEB_SCRAPER_INTERVAL_SECONDS=21600

# Google Gemini API Key (Required for AI classification layer)
GEMINI_API_KEY=your_gemini_api_key_here

# ── Graph Expander Worker (graph_expander.py) ──────────────────────────────────
# Number of posts to fetch per channel during graph expansion (300-500 recommended)
GRAPH_EXPANDER_POST_LIMIT=400
# Seconds to sleep between each channel expansion (respect Telegram rate limits)
GRAPH_EXPANDER_INTERVAL_SECONDS=600
# Maximum graph traversal depth (channels deeper than this are not expanded further)
GRAPH_MAX_DEPTH=5
# Number of channels to process per expansion cycle
GRAPH_EXPANDER_BATCH_SIZE=15
# Seconds to sleep between full expansion cycles
GRAPH_EXPANDER_CYCLE_SLEEP=3600

# ── Seed Intake Worker (seed_intake_worker.py) ────────────────────────────────
# How often to poll the seed_channels table for new seeds (seconds)
SEED_INTAKE_POLL_SECONDS=60
# Maximum seeds to process per poll cycle
SEED_INTAKE_BATCH_SIZE=50

# ── AutoTele Integration ──────────────────────────────────────────────────────
# AutoTele inserts channel usernames into the seed_channels table.
# The seed_intake_worker.py automatically picks them up and queues for validation.
# No additional configuration needed — just grant AutoTele DB write access.

# ── Outreach Engine (Risk-Aware Campaign Dispatcher) ─────────────────────────
# Global outreach kill switch (set to false to stop all outreach immediately)
OUTREACH_ENABLED=true
# Dry-run mode: runs full qualification pipeline but skips actual Telegram sends
OUTREACH_DRY_RUN=false
# Canary mode batch size: number of leads to test before full campaign rollout
OUTREACH_CANARY_SIZE=5
# Maximum retry attempts for a single delivery before marking as failed
OUTREACH_MAX_RETRIES=3
# Minimum days between outreach contacts to the same lead
OUTREACH_LEAD_COOLDOWN_DAYS=30
# Reconciliation cycle interval (seconds): checks for stuck deliveries
OUTREACH_RECONCILIATION_INTERVAL=300

# ── Campaign Pacing (existing, documented for reference) ─────────────────────
# CAMPAIGN_DAILY_LIMIT=60      # Max messages per day per account
# CAMPAIGN_JITTER_MIN=90       # Minimum seconds between sends
# CAMPAIGN_JITTER_MAX=210      # Maximum seconds between sends
# CAMPAIGN_BURST_SIZE=5        # Messages before a micro-break
